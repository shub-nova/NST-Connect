NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:3001

DATABASE_URL=postgresql://nstconnect:nstconnect_dev@localhost:5432/nstconnect

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Student sign-up domain. To TEST real email with an address you own, add it after a comma
# (STUDENT_EMAIL_DOMAIN=adypu.edu.in,gmail.com) and remove it again before going live.
# A production deployment refuses extra domains unless ALLOW_TEST_STUDENT_DOMAINS=true is set (testing only).
STUDENT_EMAIL_DOMAIN=adypu.edu.in
POC_EMAIL_DOMAIN=newtonschool.co

# Email. Leave SMTP_USER empty in development: Mailpit (http://localhost:8025) catches everything and nothing
# reaches a real inbox. To send REAL email (sign-up verification etc.), fill in a provider, for example Brevo:
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587   SMTP_USER=<your SMTP login>   SMTP_PASS=<your SMTP key>
#   MAIL_FROM="NST Connect <the sender address you verified with the provider>"
# Then check it with:  npm run mail:test -w apps/api -- you@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="NST Connect <no-reply@nstconnect.local>"

# Automatic escalation (a ticket the assigned POC ignores for 48h moves up a level)
ESCALATION_JOB_ENABLED=true
ESCALATION_INTERVAL_MINUTES=15
TAT_WARNING_HOURS=12
# Optional: lets an external scheduler call POST /internal/escalation/run (header x-job-secret).
# JOB_SECRET=at-least-16-random-characters

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=nst-connect-attachments
S3_ACCESS_KEY=nstconnect
S3_SECRET_KEY=nstconnect_dev_secret
