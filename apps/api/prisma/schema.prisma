// NST Connect database schema. Source of truth: docs/er-diagram.md

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  POC
  SUPER_ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  CREATED
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  /// Finished with a fix. Shown to people as "Solved".
  RESOLVED
  /// Finished without a fix (invalid, duplicate, not possible).
  CLOSED
  REOPENED
}

enum EventType {
  CREATED
  ASSIGNED
  COMMENTED
  STATUS_CHANGED
  ESCALATED
  TAT_BREACHED
  NUDGED
  RESOLVED
  CLOSED
  REOPENED
  LINKED
  UNLINKED
  /// A POC's open ticket was handed to someone else (they went on leave, or were removed). Internal only.
  REASSIGNED
  /// The student closed their own ticket. Not a POC outcome, so analytics never count it as Solved or Closed.
  CLOSED_BY_STUDENT
}

/// How a student felt about the outcome of a finished ticket.
enum FeedbackRating {
  SATISFIED
  OKAY
  NOT_SATISFIED
}

enum Visibility {
  PUBLIC
  INTERNAL
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
}

enum NotificationType {
  STATUS_CHANGE
  COMMENT
  MENTION
  ESCALATION
  RESOLVED
  NUDGE
  NEW_TICKET
  /// To the assigned POC: the 48h limit is close.
  TAT_WARNING
  /// To the POC who let the limit pass without acting.
  TAT_MISSED
  /// To admins: a ticket reached the top level and still nobody acted.
  CRITICAL
}

/// Why a ticket was escalated.
enum EscalationReason {
  /// A POC chose to escalate.
  MANUAL
  /// The assigned POC did nothing for 48 hours.
  TAT_BREACH
  /// The POC went on leave or was removed and nobody else at their level was on duty.
  ON_LEAVE
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String?   @map("password_hash")
  role            Role
  enrollmentId    String?   @map("enrollment_id")
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Set when a staff member is removed from their last role. They can no longer log in.
  deactivatedAt   DateTime? @map("deactivated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  pocAssignments POCAssignment[]
  ticketsRaised  Ticket[]           @relation("TicketStudent")
  ticketsHeld    Ticket[]           @relation("TicketAssignedPoc")
  events         TicketEvent[]      @relation("EventActor")
  eventsReceived TicketEvent[]      @relation("EventAssignee")
  comments       Comment[]
  mentions       CommentMention[]
  attachments    Attachment[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  notesWritten   AdminNote[]        @relation("NoteAuthor")
  staffChanges   StaffAudit[]       @relation("AuditActor")
  feedbackGiven  TicketFeedback[]   @relation("FeedbackStudent")
  feedbackEarned TicketFeedback[]   @relation("FeedbackFinisher")
  staffAuditedOn StaffAudit[]       @relation("AuditTarget")
  noteReceipts   AdminNoteReceipt[]

  @@map("user")
}

model Category {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  /// Short label for chips and team names, e.g. "Hostel" for "Hostel & Accommodation".
  shortName String  @default("") @map("short_name")
  sortOrder Int     @default(0) @map("sort_order")
  maxLevel  Int     @default(3) @map("max_level")
  active    Boolean @default(true)

  subCategories  SubCategory[]
  pocAssignments POCAssignment[]
  tickets        Ticket[]

  @@map("category")
}

model SubCategory {
  id         String  @id @default(uuid()) @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  name       String
  sortOrder  Int     @default(0) @map("sort_order")
  active     Boolean @default(true)

  category Category @relation(fields: [categoryId], references: [id])
  tickets  Ticket[]

  @@unique([categoryId, name])
  @@map("sub_category")
}

model POCAssignment {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  categoryId          String    @map("category_id") @db.Uuid
  level               Int
  managerAssignmentId String?   @map("manager_assignment_id") @db.Uuid
  active              Boolean   @default(true)
  onLeave             Boolean   @default(false) @map("on_leave")
  /// When set, leave ends by itself on this date.
  onLeaveUntil        DateTime? @map("on_leave_until")

  user     User            @relation(fields: [userId], references: [id])
  category Category        @relation(fields: [categoryId], references: [id])
  manager  POCAssignment?  @relation("Manages", fields: [managerAssignmentId], references: [id])
  reports  POCAssignment[] @relation("Manages")

  @@unique([userId, categoryId])
  @@index([categoryId, level, active])
  @@map("poc_assignment")
}

model Ticket {
  id              String       @id @default(uuid()) @db.Uuid
  title           String
  description     String
  categoryId      String       @map("category_id") @db.Uuid
  subCategoryId   String?      @map("sub_category_id") @db.Uuid
  studentId       String       @map("student_id") @db.Uuid
  priority        Priority     @default(MEDIUM)
  status          TicketStatus @default(CREATED)
  currentLevel    Int          @default(1) @map("current_level")
  resolvedLevel   Int?         @map("resolved_level")
  assignedPocId   String?      @map("assigned_poc_id") @db.Uuid
  tatDeadline     DateTime?    @map("tat_deadline")
  /// When the "12 hours left" warning was sent for the current deadline. Reset whenever the deadline resets.
  tatWarnedAt     DateTime?    @map("tat_warned_at")
  critical        Boolean      @default(false)
  /// Closed by the student themselves (status is CLOSED). It leaves the POC's open queue and is not a POC outcome.
  closedByStudent Boolean      @default(false) @map("closed_by_student")
  parentTicketId  String?      @map("parent_ticket_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  resolvedAt      DateTime?    @map("resolved_at")

  category      Category         @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory?     @relation(fields: [subCategoryId], references: [id])
  student       User             @relation("TicketStudent", fields: [studentId], references: [id])
  assignedPoc   User?            @relation("TicketAssignedPoc", fields: [assignedPocId], references: [id])
  parent        Ticket?          @relation("Duplicates", fields: [parentTicketId], references: [id])
  duplicates    Ticket[]         @relation("Duplicates")
  events        TicketEvent[]
  feedback      TicketFeedback[]
  comments      Comment[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([status, currentLevel, tatDeadline])
  @@index([studentId, createdAt])
  @@index([categoryId, status])
  @@map("ticket")
}

model TicketEvent {
  id         String            @id @default(uuid()) @db.Uuid
  ticketId   String            @map("ticket_id") @db.Uuid
  type       EventType
  actorId    String?           @map("actor_id") @db.Uuid
  fromStatus TicketStatus?     @map("from_status")
  toStatus   TicketStatus?     @map("to_status")
  fromLevel  Int?              @map("from_level")
  toLevel    Int?              @map("to_level")
  visibility Visibility        @default(PUBLIC)
  /// Who the ticket went to. Set on ASSIGNED, ESCALATED and REOPENED events. This is what
  /// lets analytics tell which POC a ticket was with, and for how long.
  assigneeId String?           @map("assignee_id") @db.Uuid
  /// Set on ESCALATED events.
  reason     EscalationReason?
  note       String?
  createdAt  DateTime          @default(now()) @map("created_at")

  ticket   Ticket          @relation(fields: [ticketId], references: [id])
  actor    User?           @relation("EventActor", fields: [actorId], references: [id])
  assignee User?           @relation("EventAssignee", fields: [assigneeId], references: [id])
  feedback TicketFeedback?

  @@index([ticketId, createdAt])
  @@index([createdAt])
  @@map("ticket_event")
}

model Comment {
  id              String     @id @default(uuid()) @db.Uuid
  ticketId        String     @map("ticket_id") @db.Uuid
  authorId        String     @map("author_id") @db.Uuid
  parentCommentId String?    @map("parent_comment_id") @db.Uuid
  body            String
  visibility      Visibility @default(PUBLIC)
  createdAt       DateTime   @default(now()) @map("created_at")

  ticket        Ticket           @relation(fields: [ticketId], references: [id])
  author        User             @relation(fields: [authorId], references: [id])
  parent        Comment?         @relation("Replies", fields: [parentCommentId], references: [id])
  replies       Comment[]        @relation("Replies")
  mentions      CommentMention[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([ticketId, createdAt])
  @@map("comment")
}

model CommentMention {
  commentId       String @map("comment_id") @db.Uuid
  mentionedUserId String @map("mentioned_user_id") @db.Uuid

  comment Comment @relation(fields: [commentId], references: [id])
  user    User    @relation(fields: [mentionedUserId], references: [id])

  @@id([commentId, mentionedUserId])
  @@map("comment_mention")
}

model Attachment {
  id         String     @id @default(uuid()) @db.Uuid
  ticketId   String     @map("ticket_id") @db.Uuid
  commentId  String?    @map("comment_id") @db.Uuid
  uploaderId String     @map("uploader_id") @db.Uuid
  storageKey String     @unique @map("storage_key")
  fileName   String     @map("file_name")
  mimeType   String     @map("mime_type")
  sizeBytes  BigInt     @map("size_bytes")
  scanStatus ScanStatus @default(PENDING) @map("scan_status")
  createdAt  DateTime   @default(now()) @map("created_at")

  ticket   Ticket   @relation(fields: [ticketId], references: [id])
  comment  Comment? @relation(fields: [commentId], references: [id])
  uploader User     @relation(fields: [uploaderId], references: [id])

  @@index([ticketId])
  @@map("attachment")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  ticketId  String?          @map("ticket_id") @db.Uuid
  commentId String?          @map("comment_id") @db.Uuid
  readAt    DateTime?        @map("read_at")
  emailedAt DateTime?        @map("emailed_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  ticket  Ticket?  @relation(fields: [ticketId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])

  @@index([userId, readAt])
  @@map("notification")
}

/// Who changed the team and how: adding, editing, removing a POC, leave, invites. Shown as "Recent changes".
model StaffAudit {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  /// ADDED, UPDATED, REMOVED, LEAVE_ON, LEAVE_OFF, INVITE_SENT
  action       String
  targetUserId String?  @map("target_user_id") @db.Uuid
  categoryId   String?  @map("category_id") @db.Uuid
  /// A readable summary, e.g. "Added Ravi as L1".
  summary      String
  createdAt    DateTime @default(now()) @map("created_at")

  actor  User  @relation("AuditActor", fields: [actorId], references: [id])
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([categoryId, createdAt])
  @@map("staff_audit")
}

/// A student's feedback on a finished ticket. One per finish: if the ticket is reopened and finished again,
/// the student can answer again. Staff only ever see the rating and comment, never who wrote them.
model TicketFeedback {
  id            String         @id @default(uuid()) @db.Uuid
  ticketId      String         @map("ticket_id") @db.Uuid
  studentId     String         @map("student_id") @db.Uuid
  /// The Solved or Closed event this answers.
  finishEventId String         @unique @map("finish_event_id") @db.Uuid
  rating        FeedbackRating
  comment       String?
  /// The POC who solved or closed it, and the level they were at: this is who analytics credit.
  finishedById  String?        @map("finished_by_id") @db.Uuid
  finishedLevel Int?           @map("finished_level")
  categoryId    String         @map("category_id") @db.Uuid
  subCategoryId String?        @map("sub_category_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  ticket      Ticket      @relation(fields: [ticketId], references: [id])
  student     User        @relation("FeedbackStudent", fields: [studentId], references: [id])
  finishEvent TicketEvent @relation(fields: [finishEventId], references: [id])
  finishedBy  User?       @relation("FeedbackFinisher", fields: [finishedById], references: [id])

  @@index([categoryId, createdAt])
  @@index([finishedById, createdAt])
  @@index([ticketId])
  @@map("ticket_feedback")
}

/// A note the Super Admin writes after looking at the dashboards. Staff only: no student endpoint or
/// query ever touches these tables.
model AdminNote {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  /// Who it was sent to, in words, e.g. "Hostel · L2".
  audience  String
  /// What the admin was looking at, e.g. "Auto-escalated, last 30 days".
  context   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  author   User               @relation("NoteAuthor", fields: [authorId], references: [id])
  receipts AdminNoteReceipt[]

  @@index([createdAt])
  @@map("admin_note")
}

/// One row per recipient: fixes who the note went to at send time, and records when they saw it.
model AdminNoteReceipt {
  noteId String    @map("note_id") @db.Uuid
  userId String    @map("user_id") @db.Uuid
  seenAt DateTime? @map("seen_at")

  note AdminNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@id([noteId, userId])
  @@index([userId, seenAt])
  @@map("admin_note_receipt")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_token")
}

model JobHeartbeat {
  jobName   String   @id @map("job_name")
  lastRunAt DateTime @map("last_run_at")

  @@map("job_heartbeat")
}
